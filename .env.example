# Copiar a .env (ignorado por git) y completar. Nunca subir .env al repositorio.
DB_USER=epptrack
DB_PASSWORD=cambiar-esta-clave
DB_ROOT_PASSWORD=cambiar-esta-clave-root
# false en producción: evita crear los usuarios de demostración con contraseñas conocidas
DATOS_DEMO=false
# true cuando se acceda por HTTPS (Nginx)
COOKIE_SECURE=true
# Clave de la API de Claude para el asistente IA (opcional; sin ella el asistente queda deshabilitado)
ANTHROPIC_API_KEY=
